PORT=4000
# Origins allowed to call the service (the Vite dev server proxies /api, so this matters in production).
CORS_ORIGIN=http://localhost:5173

# AI project analysis for judges (optional). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model id (check availability with the Gemini models list; 2.5 models are closed to new keys).
# GEMINI_MODEL=gemini-3.8-flash
# Optional fallback model(s), comma-separated: used when the main model is overloaded
# or has used up its own quota (free-tier quotas are per model, e.g. 20 requests/day).
# GEMINI_FALLBACK_MODEL=gemini-3.7-flash,gemini-3.5-flash
# Per-member wait between AI idea requests (seconds; enforced on the server).
# AI_IDEA_COOLDOWN_SECONDS=10
# Optional GitHub token (read-only, public repos) to raise the API rate limit
GITHUB_TOKEN=

# ---------- Unstop listings (see docs/unstop-integration.md) ----------
# Unstop has no public API. Leave "off" until you have authorized access.
#   off  = disabled (default) · feed = authorized JSON feed/API · mock = labelled mock data, local dev only
UNSTOP_PROVIDER=off
# Authorized feed endpoint (official Unstop API access or a licensed partner feed) + its key, if any
UNSTOP_FEED_URL=
UNSTOP_API_KEY=
# Listing links must be on these hosts (source attribution)
UNSTOP_ALLOWED_HOSTS=unstop.com
UNSTOP_CACHE_TTL_SECONDS=900
UNSTOP_TIMEOUT_MS=15000
# 0 = refresh lazily when the cache expires; e.g. 30 = also sync every 30 minutes
UNSTOP_SYNC_INTERVAL_MINUTES=0
UNSTOP_MAX_EVENTS=500
# false = keep listings in memory only (no database copy)
UNSTOP_PERSIST=true

# ---------- GitHub integration (optional) ----------
# Public repositories work without this. To let members connect their GitHub account
# (needed for private repos), create a GitHub OAuth App:
#   https://github.com/settings/developers → New OAuth App
#   Authorization callback URL = GITHUB_OAUTH_CALLBACK_URL (default: APP_URL + /api/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/github/callback
# read:user = public repos only; "read:user repo" to allow private repos
GITHUB_OAUTH_SCOPES=read:user
# Encrypts stored access tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENCRYPTION_KEY=

# ---- Participant chat (enforced in the database; the UI only mirrors these) ----
# Seconds a participant must wait between messages.
CHAT_MESSAGE_COOLDOWN_SECONDS=5
# Burst limit: messages per participant per rolling minute.
CHAT_MAX_MESSAGES_PER_MINUTE=10
# Maximum characters per message (hard cap 4000).
CHAT_MAX_MESSAGE_LENGTH=1000
# Reject the same message from the same person within this many seconds (0 = off).
CHAT_DUPLICATE_WINDOW_SECONDS=60
# After the hackathon ends the chat becomes read-only (set to false to keep it open).
CHAT_READ_ONLY_AFTER_END=true

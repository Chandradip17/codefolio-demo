# Copy to .env and fill in from Supabase → Project Settings → API (or "API Keys").
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon" / publishable key: used server-side only for password sign-in + token refresh.
SUPABASE_ANON_KEY=
# "service_role" / secret key: full access. Keep it on the server; never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

PORT=4000
# Comma-separated origins allowed to call the API (the Vite dev server proxies /api, so this mainly matters in production).
CORS_ORIGIN=http://localhost:5173
# Public Storage bucket for organizer-uploaded event images (created automatically).
SUPABASE_IMAGE_BUCKET=event-images

# Frontend URL: password-reset emails link to APP_URL/reset-password (add it to Supabase → Auth → URL Configuration → Redirect URLs).
APP_URL=http://localhost:5173

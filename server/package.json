{
  "name": "codefolio-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Codefolio API: Node + Express + Supabase",
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js",
    "test:sql": "node scripts/test-sql.js",
    "test:phase1": "node scripts/test-phase1.js",
    "dev:watch": "node --watch-path=./src --env-file-if-exists=.env src/index.js",
    "test:phase2": "node scripts/test-phase2.js",
    "smoke:phase2": "node --env-file-if-exists=.env scripts/smoke-phase2.js",
    "smoke:teams": "node --env-file-if-exists=.env scripts/smoke-teams.js",
    "smoke:fees": "node --env-file-if-exists=.env scripts/smoke-fees.js",
    "test:judging": "node scripts/test-judging.js",
    "smoke:judging": "node --env-file-if-exists=.env scripts/smoke-judging.js",
    "test:unstop": "node --env-file-if-exists=.env scripts/test-unstop.js",
    "test:matcher-demo": "node scripts/test-matcher-demo.js",
    "test:github-matching": "node scripts/test-github-matching.js",
    "test:comms-analytics": "node scripts/test-comms-analytics.js",
    "test:ideas-analytics": "node scripts/test-ideas-analytics.js",
    "smoke:ideas-comms": "node --env-file-if-exists=.env scripts/smoke-ideas-comms.js",
    "test:chat": "node scripts/test-chat.js",
    "smoke:chat": "node --env-file-if-exists=.env scripts/smoke-chat.js",
    "smoke:advanced": "node --env-file-if-exists=.env scripts/smoke-advanced.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
